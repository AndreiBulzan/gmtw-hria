{"id": "Github_medium/test/o9518", "schema": {"description": "A **PDF Manager template** contains the configuration that determines the contents of a **PDF Manager batch**.  It is configured in the user interface and only *readable* in the API.", "links": [{"description": "List existing PDF Manager templates.", "href": "/api/v1/user_identities/:user_identity_id/pdf_manager_templates", "http_header": {"x-api-key": "0123456789abcdef0123456789abcdef"}, "method": "GET", "rel": "instances", "targetSchema": {"properties": {"href": {"example": "/api/v1/user_identities/1/pdf_manager_templates", "pattern": "/api/v1/user_identities/\\d+/pdf_manager_templates", "type": "string"}, "pdf_manager_templates": {"items": {"properties": {"document_source_title": {"example": "Full Application PDF", "type": "string"}, "href": {"example": "/api/v1/user_identities/1/pdf_manager_templates/2", "pattern": "/api/v1/user_identities/\\d+/pdf_manager_templates/\\d+", "type": "string"}, "id": {"example": 2, "type": "integer"}, "list_name": {"example": "Offer Accepted", "type": "string"}, "name": {"example": "Accepted Offers for Review", "type": "string"}}, "required": ["href", "id", "name", "list_name", "document_source_title"], "type": "object"}, "type": "array"}}}, "title": "List"}, {"description": "Display an existing PDF Manager template.", "href": "/api/v1/user_identities/:user_identity_id/pdf_manager_templates/:pdf_manager_template_id", "http_header": {"x-api-key": "0123456789abcdef0123456789abcdef"}, "method": "GET", "rel": "self", "title": "Show"}], "properties": {"pdf_manager_template": {"properties": {"document_source_title": {"description": "Human-readable name of the document source that is used when populating this template.", "example": "Full Application PDF", "type": "string"}, "href": {"description": "Hypertext reference to this resource.", "example": "/api/v1/user_identities/1/pdf_manager_templates/2", "pattern": "/api/v1/user_identities/\\d+/pdf_manager_templates/\\d+", "type": "string"}, "id": {"description": "Unique identifier of this PDF Manager template.", "example": 2, "type": "integer"}, "list_name": {"description": "Human-readable name of the list that is used when populating this template.", "example": "Offer Accepted", "type": "string"}, "name": {"description": "Human-readable name of this PDF Manager template.", "example": "Accepted Offers for Review", "type": "string"}}, "required": ["href", "id", "name", "list_name", "document_source_title"], "type": "object"}}, "stability": "production", "strictProperties": true, "title": "PDF Manager Template", "type": "object"}, "stratum": "core", "script": "latin"}
