uid"}, "name": {"description": "text to display", "type": "string"}, "event_id": {"description": "global id that allows the sender to link a message/job with an interal event", "type": "string", "format": "uuid"}}}}, "properties": {"Message": {"$ref": "#/definitions/Message"}, "NotifyJob": {"$ref": "#/definitions/NotifyJob"}, "Sender": {"$ref": "#/definitions/Sender"}}, "required": ["Message", "NotifyJob", "Sender"]}, "stratum": "core", "script": "latin"}
