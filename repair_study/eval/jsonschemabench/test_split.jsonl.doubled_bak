 "string"}, "title": {"description": "Title of exchange entry", "type": "string"}, "type": {"description": "Type of entry, currently only `topic-exchange`.", "enum": ["topic-exchange"], "type": "string"}}, "required": ["type", "exchange", "name", "title", "description", "routingKey", "schema"], "type": "object"}, "type": "array"}, "exchangePrefix": {"description": "Prefix for all exchanges described in this document", "type": "string"}, "title": {"description": "Title for set of exchanges in markdown", "type": "string"}, "version": {"description": "Exchange reference version", "enum": [0, "0.2.0"]}}, "required": ["version", "$schema", "title", "description", "exchangePrefix", "entries"], "title": "Exchange Reference File", "type": "object"}, "stratum": "core", "script": "latin"}
