Items": 4}, {"type": "number"}]}, "description": {"description": "A description of the parameter", "type": "string"}}, "required": ["type", "glsl_name", "name", "defualt"]}}}, "required": ["asset_type"]}, "stratum": "core", "script": "latin"}
