{"id": "Github_medium/test/o13189", "schema": {"$schema": "http://json-schema.org/draft-04/schema#", "description": "This is a list of entries in RNAcentral to be imported by ensembl. This list should be kept small enough to easily fit in memory and thus not all entries at once.", "items": {"description": "This is an entry in RNAcentral that is active (has at least 1 active xref)", "properties": {"description": {"description": "Human readable name of the sequence", "minLength": 1, "type": "string"}, "md5": {"description": "The MD5 hash of the sequence in lowercase", "pattern": "^[a-f\\d]{32}$", "type": "string"}, "rna_type": {"description": "The INSDC type of the sequence", "enum": ["RNase_MRP_RNA", "RNase_P_RNA", "SRP_RNA", "Y_RNA", "antisense_RNA", "autocatalytically_spliced_intron", "guide_RNA", "hammerhead_ribozyme", "lncRNA", "miRNA", "misc_RNA", "ncRNA", "other", "piRNA", "precursor_RNA", "rRNA", "rasiRNA", "ribozyme", "sRNA", "scRNA", "scaRNA", "siRNA", "snRNA", "snoRNA", "tRNA", "telomerase_RNA", "tmRNA", "vault_RNA"]}, "rnacentral_id": {"description": "The specific specific URS of the sequence in RNAcentral", "pattern": "^URS[A-Z0-9]{10}_\\d+$", "type": "string"}, "sequence": {"description": "The sequence in uppercase with U's.", "minLength": 10, "pattern": "^[ACGTYRWSKMDVHBNXFI]+$", "type": "string"}, "taxon_id": {"description": "NCBI taxon id of the organism", "type": "number"}, "xrefs": {"description": "A list of cross references that other databases can use. These will only be the 'high quality' references from RNAcentral.", "items": {"description": "This represents a reference from this sequence to a different high quality database that RNAcentral can provide", "properties": {"database": {"description": "Human readable name of the database this Xref comes from", "enum": ["GtRNAdb", "lncRNAdb", "miRBase", "Modomics", "PDBe", "SNOpy", "srPDB", "tmRNA Website", "Rfam"]}, "id": {"description": "ID of this sequence in this database", "minLength": 1, "type": "string"}}, "required": ["database", "id"], "title": "RNAcentral Cross-reference", "type": "object"}, "type": "array", "_uniqueItems": true}}, "required": ["rnacentral_id", "description", "sequence", "md5", "rna_type", "taxon_id", "xrefs"], "title": "RNAcentral Entry", "type": "object"}, "minItems": 1, "type": "array", "_uniqueItems": true}, "stratum": "core", "script": "latin"}
