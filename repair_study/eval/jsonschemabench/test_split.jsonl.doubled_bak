is up to the consumer to make use of the dereferenced messages if/when they are provided."}, "links": {"type": "object", "patternProperties": {"^[a-zA-Z_]{1}[\\w\\.:-]+$": {"type": "string", "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$"}}, "additionalProperties": false, "description": "@link https://en.wikipedia.org/wiki/HATEOAS"}}, "required": ["_schema", "envelope_id"], "additionalProperties": false}, "stratum": "core", "script": "latin"}
