{"id": "Github_medium/test/o65426", "schema": {"$schema": "http://json-schema.org/draft-04/schema#", "additionalProperties": false, "definitions": {}, "description": "A Financial Payment is a payment from government to a recipient", "properties": {"company_jurisdiction": {"description": "Jurisdiction where company is based", "type": "string"}, "company_name": {"description": "Name of the company that received the money", "type": "string"}, "confidence": {"description": "Confidence in accuracy of data", "enum": ["HIGH", "MEDIUM", "LOW"], "type": "string"}, "csv_line_number": {"description": "If the source for the data is a CSV file, you can optionally include the line number of the CSV from which this data was retrieved", "type": ["string", "null"]}, "currency": {"description": "The currency of the payment (three letter symbol, e.g. USD, GBP, EUR)", "type": "string"}, "date": {"_format": "date", "description": "The date on which the payment was made", "type": "string"}, "department_name": {"description": "The name of the government department which the entity belongs to (if relevant), e.g. Department of Health", "type": ["string", "null"]}, "description": {"description": "The description of the transaction as given in the raw data", "type": ["string", "null"]}, "entity_name": {"description": "The name of the government entity that made the payment, e.g. Environment Agency", "type": "string"}, "entity_uri": {"description": "A unique URL (ideally a dereferencable URI) for the government entity", "type": ["string", "null"]}, "expense_area": {"description": "category (in words) of the expenditure", "type": ["string", "null"]}, "expense_type": {"description": "The type of expense -- can be either capital, revenue (i.e. current expenditure) or null", "enum": ["capital", "revenue", null]}, "jurisdiction": {"description": "The jurisdiction of the body that made the payment, eg. UK, France, Delaware, Manchester", "type": "string"}, "more_details_url": {"description": "A url from which more details can be seen (may be the same as the source_url)", "type": ["string", "null"]}, "payee_name": {"description": "The name of the payee (the entity that received the money)", "type": "string"}, "retrieved_at": {"_format": "date", "type": "string"}, "sample_date": {"_format": "date", "description": "Date on which this fact was known to be true", "type": "string"}, "source_url": {"description": "Place where this fact can be verified", "type": "string"}, "transaction_number": {"description": "The unique identifier for the transaction, scoped to this bot", "type": "string"}, "value": {"description": "The amount transacted (e.g. 19.95)", "type": "string"}}, "required": ["source_url", "sample_date", "company_name", "company_jurisdiction", "value", "payee_name", "date", "currency"], "type": "object"}, "stratum": "core", "script": "latin"}
