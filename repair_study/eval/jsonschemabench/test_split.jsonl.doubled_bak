{"id": "Github_medium/test/o61585", "schema": {"properties": {"AutoBackup": {"default": true, "description": "Set Time Machine to Back Up Automatically.  Set to \"True\" to set the preference.  Please note that the \"Backup Destination\" preference must also be set if using this preference.", "type": "boolean"}, "BackupAllVolumes": {"default": false, "description": "Set Time Machine to Back Up All Volumes.  Set to \"True\" to set the preference to backup all volumes.  Set to \"False\" to set the preference to backup the startup volume only.  Please note that the \"Backup Destination\" preference must also be set if using this preference.", "type": "boolean"}, "BackupDestURL": {"default": "afp://someserver.apple.com/Backups/", "description": "Set Time Machine Backup Destination.  Set to the server address of the destination you would like to set.  Example:  afp://someserver.apple.com/Backups/.  Note that the sharepoint must be hosted on a server running Mac OS X 10.5 or higher and must have be enabled as a Time Machine backup destination.  Users must also have read/write access to the sharepoint.", "type": "string"}, "BackupSizeMB": {"default": 5000, "description": "Set Time Machine per client backup limit (in MB).  Set to the number of maximum MB you would like to allow for each client.  Example:  5000.  This setting applies to 10.5 and higher.", "type": "number"}, "BackupSkipSys": {"default": true, "description": "Set Time Machine preference to skip system file backup.  Set to \"True\" to skip system file backup.  This setting applies to 10.5 and higher.", "type": "boolean"}, "BasePaths": {"description": "Unverified - BasePaths to back up", "type": "array"}, "MobileBackups": {"default": true, "description": "Unverified - Backup mobile users?", "type": "boolean"}, "PayloadDescription": {"default": "Time Machine Settings", "description": "Description of the payload", "type": "string"}, "PayloadDisplayName": {"default": "Time Machine Settings", "description": "Name of the payload", "type": "string"}, "PayloadIdentifier": {"default": "com.apple.MCX.TimeMachine", "description": "A unique identifier for the payload, dot-delimited.  Usually root PayloadIdentifier+subidentifier", "type": "string"}, "PayloadOrganization": {"description": "This value describes the issuing organization of the profile, as displayed to the user", "type": "string"}, "PayloadType": {"default": "com.apple.MCX.TimeMachine", "description": "The type of the payload, a reverse dns string", "type": "string"}, "PayloadUUID": {"default": "", "description": "Unique identifier for the payload (format 01234567-89AB-CDEF-0123-456789ABCDEF)", "pattern": "^[0-9A-Za-z]{8}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{4}-[0-9A-Za-z]{12}$", "type": "string"}, "PayloadVersion": {"default": 1, "description": "The version of the whole configuration profile.", "type": "number"}, "SkipPaths": {"description": "Unverified - SkipPaths, paths to skip", "type": "array"}}, "title": "com.apple.MCX.TimeMachine", "type": "object"}, "stratum": "core", "script": "latin"}
