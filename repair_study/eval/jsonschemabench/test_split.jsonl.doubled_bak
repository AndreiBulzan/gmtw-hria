ed.", "not": {"required": ["crs", "srs"]}}]}, {"description": "Either 'json' or 'vector_layers' is required.", "anyOf": [{"required": ["json"]}, {"required": ["vector_layers"]}]}]}, "stratum": "core", "script": "latin"}
